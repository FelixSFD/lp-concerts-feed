{
  "name": "lp-calendar-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate": "npm run generate-v2 && npm run generate-v3",
    "generate-v2": "openapi-generator-cli generate -i ../../openapi.yaml -g typescript-angular -o src/app/modules/lpshows-api --additional-properties fileNaming=kebab-case,withInterfaces=true,modelSuffix=Dto --generate-alias-as-model",
    "generate-v3": "openapi-generator-cli generate -i ../../Common.Contracts/openapi_v3.yaml -g typescript-angular -o src/app/modules/lpshows-api/v3 --additional-properties fileNaming=kebab-case,withInterfaces=true,modelSuffix=Dto,serviceSuffix=Api,serviceFileSuffix=.api --generate-alias-as-model",
    "start": "npm run generate && ng serve",
    "build": "npm run generate && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run generate && ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/forms": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "@angular/platform-browser-dynamic": "^22.1.5",
    "@angular/router": "^22.1.5",
    "@apple/mapkit-loader": "^1.0.0",
    "@popperjs/core": "^2.11.8",
    "@primeuix/themes": "^2.0.3",
    "angular-auth-oidc-client": "^21.0.3",
    "chart.js": "^4.5.1",
    "cookieconsent": "^3.1.1",
    "guid-typescript": "^1.0.9",
    "luxon": "^3.7.2",
    "luxon-angular": "^6.0.0",
    "ngx-cookieconsent": "^8.0.0",
    "ngx-matomo-client": "^10.0.0",
    "primeflex": "^4.0.0",
    "primeicons": "^8.0.0",
    "primeng": "22.1.0-rc.1",
    "rxjs": "~7.8.2",
    "timezones-list": "^3.1.0",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.5",
    "@angular/localize": "22.1.5",
    "@openapitools/openapi-generator-cli": "^2.40.1",
    "@types/jasmine": "~5.1.15",
    "@types/luxon": "^3.7.1",
    "@types/musickit-js": "^1.0.11",
    "jasmine-core": "~5.13.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  }
}
