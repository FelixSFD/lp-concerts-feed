{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
    },
    "AdditionalHttpHeaders": [],
    "ResponseBodyLogLimit": 1024
  },
  "OpenTelemetry": {
    "Alloy": {
      "SendLogs": false,
      "Url": "http://alloy:4317"
    },
    "TelemetryEnvironmentName": "default"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "lpdb": ""
  },
  "Cognito": {
    "AppClientId": "<AppClientId>",
    "UserPoolId": "<UserPoolId>",
    "AWSRegion": "<AWSRegion>"
  },
  "EnableSwaggerUI": false,
  "CORS": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "QUERY",
      "OPTIONS"
    ]
  },
  "AppleMusic": {
    "PrivateKey": "",
    "KeyId": "",
    "TeamId": ""
  },
  "Quartz": {
    "Dashboard": {
      "Enabled": true,
      "Readonly": true
    },
    "ConnectionString": ""
  },
  "SharePics": {
    "Gotenberg": {
      "BaseUrl": "http://gotenberg:3000"
    },
    "BucketName": null,
    "TemplateBaseDir": "./Templates"
  },
  "ConcertImageUpload": {
    "BucketName": ""
  }
}
